# Use NordVPN service credentials, not your account email/password or app token.
NORDVPN_USERNAME=replace_with_service_username
NORDVPN_PASSWORD=replace_with_service_password

# Change any country without changing the fixed SOCKS ports.
LOC_DE=Germany
LOC_GR=Greece
LOC_BG=Bulgaria
LOC_RO=Romania
LOC_AT=Austria

PORT_DE=1081
PORT_GR=1082
PORT_BG=1083
PORT_RO=1084
PORT_AT=1085
TZ=Europe/Istanbul
